{%- comment -%} Native dialog cart drawer. [data-cart-content] is refreshed by theme.js via Section Rendering / Ajax API. {%- endcomment -%}
<dialog id="cart-drawer" class="drawer drawer--left" aria-labelledby="CartDrawerTitle">
  <div class="drawer__inner">
    <div class="drawer__head">
      <h2 id="CartDrawerTitle" class="drawer__title">سلّتكِ</h2>
      <form method="dialog"><button class="icon-btn" aria-label="إغلاق السلة">{% render 'icon', name: 'close' %}</button></form>
    </div>
    <div class="drawer__body" data-cart-content aria-live="polite">
      {%- if cart.item_count == 0 -%}
        <div class="empty-state">
          <span class="empty-state__arch">{% render 'icon', name: 'bag' %}</span>
          <p class="empty-state__title">السلة فارغة الآن</p>
          <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">تسوّقي الآن</a>
        </div>
      {%- else -%}
        <ul class="cart-lines">
          {%- for item in cart.items -%}
            <li class="cart-line" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
              {%- if item.image -%}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="80" height="100" loading="lazy" class="cart-line__img">{%- endif -%}
              <div class="cart-line__info">
                {%- if item.vendor != blank -%}<p class="meta">{{ item.vendor }}</p>{%- endif -%}
                <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="meta">{{ item.variant.title }}</p>{%- endunless -%}
                <div class="cart-line__row">
                  <span class="qty-label">الكمية: <span class="num">{{ item.quantity }}</span></span>
                  <span class="price">{{ item.final_line_price | money }}</span>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="drawer__foot">
      <div class="subtotal"><span>المجموع الفرعي</span><span data-cart-subtotal>{{ cart.total_price | money }}</span></div>
      <p class="meta">تُحتسب تكاليف الشحن والضرائب النهائية في صفحة الدفع حسب السوق.</p>
      <a href="{{ routes.cart_url }}" class="btn btn--ghost btn--block">عرض السلة</a>
      <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="btn btn--primary btn--block"{% if cart.item_count == 0 %} disabled{% endif %}>إتمام الطلب</button></form>
    </div>
  </div>
</dialog>

{%- comment -%} Usage: {% render 'icon', name: 'search' %} — consistent 1.6px stroke line icons. Directional arrows flip via .icon--dir in RTL. {%- endcomment -%}
<svg class="icon icon--{{ name }}{% if name == 'arrow' or name == 'chevron' %} icon--dir{% endif %}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- case name -%}
  {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
  {%- when 'bag' -%}<path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
  {%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
  {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
  {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h10"/>
  {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
  {%- when 'arrow' -%}<path d="M19 12H5M11 6l-6 6 6 6"/>
  {%- when 'chevron' -%}<path d="m6 9 6 6 6-6"/>
  {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
  {%- when 'minus' -%}<path d="M5 12h14"/>
  {%- when 'filter' -%}<path d="M4 6h16M7 12h10M10 18h4"/>
  {%- when 'trash' -%}<path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>
  {%- when 'check' -%}<path d="m5 12 5 5 9-10"/>
  {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>
  {%- when 'leaf' -%}<path d="M12 21C6 17 5 9 10 3c5 6 6 13 2 18z"/><path d="M12 21c0-6-1-11-2-18"/>
  {%- when 'sparkle' -%}<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18"/>
  {%- when 'shield' -%}<path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3z"/><path d="m9 12 2 2 4-4"/>
  {%- when 'doc' -%}<path d="M7 3h7l4 4v14H7z"/><path d="M10 12h5M10 16h5"/>
  {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4z"/>
  {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/>
  {%- when 'tiktok' -%}<path d="M14 3v11a4 4 0 1 1-4-4"/><path d="M14 3c.5 3 2.5 5 5 5"/>
  {%- when 'snapchat' -%}<path d="M12 3c3 0 5 2 5 5v3l2 1-2 1c-.5 2-2 3-5 4-3-1-4.5-2-5-4l-2-1 2-1V8c0-3 2-5 5-5z"/>
  {%- when 'whatsapp' -%}<path d="M3 21l1.6-4.9A8.5 8.5 0 1 1 8 19.5L3 21z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8c-1-.4-1.9-1.3-2.3-2.3l.8-1-1-2L9 8.5z"/>
  {%- when 'x' -%}<path d="M4 4l16 16M20 4 4 20"/>
  {%- else -%}<circle cx="12" cy="12" r="8"/>
{%- endcase -%}
</svg>

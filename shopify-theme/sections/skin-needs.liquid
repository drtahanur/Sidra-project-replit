{%- liquid
  assign configured = 0
  for block in section.blocks
    if block.settings.link != blank or block.settings.collection != blank
      assign configured = configured | plus: 1
    endif
  endfor
-%}
{%- if configured > 0 or request.design_mode -%}
<section class="section skin-needs">
  <div class="container center-head">
    {%- if section.settings.kicker != blank -%}<p class="kicker kicker--center">{{ section.settings.kicker }}</p>{%- endif -%}
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="meta">{{ section.settings.text }}</p>{%- endif -%}
    {%- if request.design_mode and configured < section.blocks.size -%}<div class="editor-note">محرر القالب فقط: اربطي كل احتياج بتصنيف أو رابط مبني على بيانات موثقة للمنتجات. العناصر غير المرتبطة مخفية عن الزوار.</div>{%- endif -%}
    <ul class="need-chips">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign url = block.settings.link
          if url == blank and c != blank
            assign url = c.url
          endif
        -%}
        {%- if url == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
        <li {{ block.shopify_attributes }}><a href="{{ url | default: routes.all_products_collection_url }}" class="need-chip">{{ block.settings.label | default: c.title }}</a></li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "حسب احتياج البشرة",
  "settings": [
    { "type": "text", "id": "kicker", "label": "عنوان صغير", "default": "حسب احتياج بشرتكِ" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "ما الذي تحتاجه بشرتكِ الآن؟" },
    { "type": "text", "id": "text", "label": "وصف (اختياري)" }
  ],
  "blocks": [
    { "type": "need", "name": "احتياج", "settings": [
      { "type": "text", "id": "label", "label": "النص", "default": "الترطيب" },
      { "type": "collection", "id": "collection", "label": "التصنيف" },
      { "type": "url", "id": "link", "label": "رابط مخصص (يتقدم على التصنيف)" }
    ]}
  ],
  "max_blocks": 10,
  "presets": [{ "name": "حسب احتياج البشرة", "blocks": [
    { "type": "need", "settings": { "label": "الترطيب" } }, { "type": "need", "settings": { "label": "الجفاف" } },
    { "type": "need", "settings": { "label": "البشرة الدهنية" } }, { "type": "need", "settings": { "label": "البشرة الحساسة" } },
    { "type": "need", "settings": { "label": "المظهر غير المتجانس" } }, { "type": "need", "settings": { "label": "الحماية من الشمس" } }
  ]}]
}
{% endschema %}

{%- paginate collection.products by section.settings.per_page -%}
<section class="section collection">
  <div class="container">
    <header class="page-banner">
      <div class="page-banner__copy">
        <nav class="breadcrumbs" aria-label="مسار التنقل"><a href="{{ routes.root_url }}">الرئيسية</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title }}</span></nav>
        <h1 class="page-title">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}<div class="rte meta">{{ collection.description }}</div>{%- endif -%}
        <p class="count">{{ collection.products_count }} منتجات</p>
      </div>
      {%- if collection.image and section.settings.show_image -%}<div class="page-banner__media">{{ collection.image | image_url: width: 1200 | image_tag: loading: 'eager', alt: collection.title }}</div>{%- endif -%}
    </header>

    <div class="facets">
      <div class="facets__layout">
        <button type="button" class="btn btn--ghost btn--sm facets__toggle" aria-expanded="false" aria-controls="FacetsPanel" data-facets-toggle>{% render 'icon', name: 'filter' %}الفلاتر</button>
        <form id="CollectionFilters" class="facets__panel" action="{{ collection.url }}" method="get" data-facets-panel>
          <div class="facets__panel-head"><h2>الفلاتر</h2><button type="button" class="icon-btn" data-facets-toggle aria-label="إغلاق الفلاتر">{% render 'icon', name: 'close' %}</button></div>
          {%- for filter in collection.filters -%}
            <details class="facet" open>
              <summary>{{ filter.label }}{% render 'icon', name: 'chevron' %}</summary>
              {%- case filter.type -%}
                {%- when 'list', 'boolean' -%}
                  <ul class="facet__list">
                    {%- for value in filter.values -%}
                      <li><label class="check{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                        <span>{{ value.label }}</span><span class="meta num">({{ value.count }})</span>
                      </label></li>
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <div class="facet__price">
                    <label>من<input type="number" step="0.01" name="{{ filter.min_value.param_name }}" {% if filter.min_value.value != nil %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %} placeholder="0" min="0" inputmode="decimal"></label>
                    <label>إلى<input type="number" step="0.01" name="{{ filter.max_value.param_name }}" {% if filter.max_value.value != nil %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %} placeholder="{{ filter.range_max | divided_by: 100.0 }}" min="0" inputmode="decimal"></label>
                  </div>
              {%- endcase -%}
            </details>
          {%- endfor -%}
          <div class="facets__actions">
            <button type="submit" class="btn btn--primary btn--block">تطبيق</button>
            <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="btn btn--ghost btn--block">مسح الكل</a>
          </div>
        </form>
        <div class="facets__results">
          <div class="toolbar">
            <p class="meta">{{ collection.products_count }} منتجات</p>
            <label class="toolbar__sort">الترتيب
              <select name="sort_by" form="CollectionFilters" class="select" onchange="this.form.submit()">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                {%- for option in collection.sort_options -%}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{%- endfor -%}
              </select>
            </label>
            <noscript><button type="submit" form="CollectionFilters" class="btn btn--sm">تحديث</button></noscript>
          </div>
          <ul class="active-facets">
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}<li><a href="{{ value.url_to_remove }}" class="chip">{{ value.label }} {% render 'icon', name: 'close' %}</a></li>{%- endfor -%}
              {%- if filter.type == 'price_range' -%}{%- if filter.min_value.value != nil or filter.max_value.value != nil -%}<li><a href="{{ filter.url_to_remove }}" class="chip">{{ filter.label }} {% render 'icon', name: 'close' %}</a></li>{%- endif -%}{%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if collection.products.size > 0 -%}
            <div class="product-grid product-grid--3">{%- for product in collection.products -%}{% render 'product-card', product: product, index: forloop.index, section_id: section.id %}{%- endfor -%}</div>
          {%- else -%}
            <div class="empty-state"><span class="empty-state__arch"></span><p class="empty-state__title">لا توجد منتجات تطابق اختياركِ</p><a href="{{ collection.url }}" class="btn btn--ghost">مسح الفلاتر</a></div>
          {%- endif -%}
          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="ترقيم الصفحات">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="pagination__arrow" aria-label="الصفحة السابقة">{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a href="{{ part.url }}" class="num">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="is-current num" aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="pagination__arrow pagination__arrow--next" aria-label="الصفحة التالية">{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
            </nav>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "صفحة التصنيف",
  "settings": [
    { "type": "range", "id": "per_page", "label": "منتجات في الصفحة", "min": 8, "max": 36, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_image", "label": "عرض صورة التصنيف", "default": true }
  ]
}
{% endschema %}

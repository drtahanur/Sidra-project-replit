{%- assign nl_id = 'NewsletterForm-' | append: section.id -%}
<section class="section newsletter">
  <div class="container container--narrow newsletter__inner">
    {% render 'icon', name: 'leaf' %}
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="meta newsletter__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- form 'customer', id: nl_id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-msg form-msg--ok" role="status" tabindex="-1" autofocus>{% render 'icon', name: 'check' %} شكرًا لاشتراككِ في نشرة سدرة.</p>
      {%- else -%}
        <div class="newsletter__row">
          <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">البريد الإلكتروني</label>
          <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="بريدكِ الإلكتروني" value="{{ form.email }}" {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}>
          <button type="submit" class="btn btn--primary">اشتراك</button>
        </div>
        {%- if form.errors -%}<p id="NewsletterError-{{ section.id }}" class="form-msg form-msg--error" role="alert">تعذّر الاشتراك. يرجى التأكد من البريد الإلكتروني والمحاولة مرة أخرى.</p>{%- endif -%}
        <label class="meta newsletter__consent">
          <input type="checkbox" name="contact[accepts_marketing]" value="true" required>
          {{ section.settings.consent }}
        </label>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "النشرة البريدية",
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "لمسة جمال تصلكِ من سدرة" },
    { "type": "text", "id": "text", "label": "الوصف", "default": "تابعي أحدث المنتجات ونصائح الجمال والعروض المميزة." },
    { "type": "text", "id": "consent", "label": "نص الموافقة", "default": "بالاشتراك توافقين على تلقي رسائل تسويقية، ويمكنكِ إلغاء الاشتراك في أي وقت." }
  ],
  "presets": [{ "name": "النشرة البريدية" }]
}
{% endschema %}

<section class="hero section" aria-labelledby="Hero-{{ section.id }}">
  <div class="container hero__grid">
    <div class="hero__copy">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h1 id="Hero-{{ section.id }}" class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="hero__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="btn-row">
        {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary">{{ section.settings.button_label }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        {%- if section.settings.button2_label != blank -%}<a href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}" class="btn btn--ghost">{{ section.settings.button2_label }}</a>{%- endif -%}
      </div>
    </div>
    <div class="hero__media">
      <div class="arch hero__arch">
        {%- if section.settings.image != blank -%}
          <picture>
            {%- if section.settings.image_mobile != blank -%}<source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">{%- endif -%}
            {%- assign image_alt = section.settings.image.alt | default: section.settings.heading -%}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1400', sizes: '(min-width: 990px) 45vw, 100vw', alt: image_alt }}
          </picture>
        {%- else -%}
          <img src="{{ 'hero.jpg' | asset_url }}" alt="منتجات عناية على أحجار لؤلؤية مع غصن سدر" width="1024" height="1024" fetchpriority="high">
        {%- endif -%}
      </div>
      {%- if section.settings.note_title != blank -%}<div class="hero__note"><span class="meta">{{ section.settings.note_kicker }}</span><strong>{{ section.settings.note_title }}</strong></div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "البانر الرئيسي",
  "settings": [
    { "type": "text", "id": "kicker", "label": "عنوان صغير", "default": "اللؤلؤ والتوت" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "جمالكِ، بتفاصيل تستحق العناية." },
    { "type": "textarea", "id": "text", "label": "الوصف", "default": "اكتشفي اختيارات مميزة للعناية ببشرتكِ وإبراز جمالكِ كل يوم." },
    { "type": "image_picker", "id": "image", "label": "الصورة" },
    { "type": "image_picker", "id": "image_mobile", "label": "صورة الهاتف (اختياري)" },
    { "type": "text", "id": "button_label", "label": "الزر الأساسي", "default": "تسوّقي الآن" },
    { "type": "url", "id": "button_link", "label": "رابط الزر الأساسي" },
    { "type": "text", "id": "button2_label", "label": "الزر الثانوي", "default": "اكتشفي العناية بالبشرة" },
    { "type": "url", "id": "button2_link", "label": "رابط الزر الثانوي" },
    { "type": "text", "id": "note_kicker", "label": "بطاقة جانبية — عنوان صغير", "default": "روتين الصباح" },
    { "type": "text", "id": "note_title", "label": "بطاقة جانبية — النص", "default": "غسول · سيروم · وقاية" }
  ],
  "presets": [{ "name": "البانر الرئيسي" }]
}
{% endschema %}

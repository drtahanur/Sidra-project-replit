{%- paginate blog.articles by section.settings.per_page -%}
<section class="section blog">
  <div class="container">
    <header class="center-head"><p class="kicker kicker--center">مجلة سدرة</p><h1 class="page-title">{{ blog.title }}</h1></header>
    {%- if blog.all_tags.size > 0 -%}
      <nav class="chips" aria-label="الوسوم"><a href="{{ blog.url }}" class="chip{% unless current_tags %} is-active{% endunless %}">الكل</a>{%- for tag in blog.all_tags -%}<a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="chip{% if current_tags contains tag %} is-active{% endif %}">{{ tag }}</a>{%- endfor -%}</nav>
    {%- endif -%}
    {%- if blog.articles.size > 0 -%}
      <div class="article-grid">
        {%- for article in blog.articles -%}
          <article class="article-card{% if forloop.first and paginate.current_page == 1 %} article-card--lead{% endif %}">
            <a href="{%- assign image_alt = article.image.alt | default: article.title -%}{{ article.url }}" class="article-card__media">{%- if article.image -%}{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: image_alt }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}</a>
            <div class="article-card__body">
              {%- if article.tags.size > 0 -%}<p class="kicker kicker--plain">{{ article.tags.first }}</p>{%- endif -%}
              <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="meta">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
              <time class="meta" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | time_tag: format: 'date' }}</time>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="ترقيم الصفحات">{{ paginate | default_pagination: previous: 'السابق', next: 'التالي' }}</nav>{%- endif -%}
    {%- else -%}
      <div class="empty-state"><span class="empty-state__arch">{% render 'icon', name: 'leaf' %}</span><p class="empty-state__title">لا توجد مقالات بعد</p></div>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "المدونة", "settings": [{ "type": "range", "id": "per_page", "label": "مقالات في الصفحة", "min": 3, "max": 24, "step": 3, "default": 9 }] }
{% endschema %}
